<%- include('partials/header.ejs') %>
<body>
   <%- include('partials/navbar.ejs') %>

    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="box">
                    <form action="#" method="POST">
                        <div class="row">
                            <div class="col-md-6">
                                <h3 class="fw-bold">Contact Details</h3>
                            </div>
                            <div class="col-md-6 text-end">
                                <a href="/" class="btn btn-primary btn-sm" title="Back"><i class="fa fa-arrow-left"></i></a>
                                <a href="/update-contact/<%= contact._id  %>" class="btn btn-success btn-sm" title="Edit"><i class="fa fa-pencil"></i></a>
                                <a href="/delete-contact/<%= contact._id %>" class="btn btn-trash btn-sm" title="Delete" onclick="return confirm('Are you sure you want to remove this record?');"><i class="fa fa-trash"></i></a>
                            </div>
                        </div>
                        <hr>
                         <table class="table">
                            <tr>
                                <td class="fw-bold text-secondary">First Name</td>
                                <td><%= contact.first_name %></td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-secondary">Last Name</td>
                                <td><%= contact.last_name %></td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-secondary">Email</td>
                                <td><%= contact.email %></td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-secondary">Phone</td>
                                <td><%= contact.phone %></td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-secondary">Address</td>
                                <td><%= contact.address %></td>
                            </tr>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer.ejs') %>

</body>
</html>