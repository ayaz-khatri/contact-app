<%- include('partials/header.ejs') %>
<body>
   <%- include('partials/navbar.ejs') %>

    <div class="container my-4">
        <div class="row">
            <div class="box">
                <div class="row">
                    <div class="col-8">
                        <h3 class="fw-bold my-0">Contacts</h3>
                    </div>
                    <div class="col-4 text-end">
                        <a href="add-contact" class="btn btn-outline-danger">Add New Contact</a>
                    </div>
                </div>
                <hr>
                <div class="table-responsive crud-table">
                    <table class="table table-striped">
                        <tr class="sticky-header">
                            <th>#</th>
                            <th>First Name</th> 
                            <th>Last Name</th> 
                            <th>Email</th> 
                            <th>Phone</th>
                            <th>Action</th> 
                        </tr>
                        <tr>
                            <td>1</td>
                            <td>Ayaz</td>
                            <td>Khatri</td>
                            <td>ayaz@gmail.com</td>
                            <td>03123456789</td>
                            <td class="action-column">
                                <a href="show-contact" class="btn btn-warning btn-sm" title="View"><i class="fa fa-eye"></i></a>
                                <a href="update-contact" class="btn btn-success btn-sm" title="Edit"><i class="fa fa-pencil"></i></a>
                                <form action="delete-contact" method="POST" class="d-inline-block">
                                    <input type="hidden" name="id">
                                    <button type="submit" name="delete" class="btn btn-trash btn-sm" title="Delete" onclick="return confirm('Are you sure you want to remove this record?');"><i class="fa fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer.ejs') %>

</body>
</html>