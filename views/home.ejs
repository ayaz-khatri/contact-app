<%- include('partials/header.ejs') %>
<body>
   <%- include('partials/navbar.ejs') %>

    <div class="container my-4">
        <div class="row">
            <div class="box">
                <div class="row">
                    <div class="col-8">
                        <h3 class="fw-bold my-0">Contacts</h3>
                    </div>
                    <div class="col-4 text-end">
                        <a href="/add-contact" class="btn btn-outline-danger">Add New Contact</a>
                    </div>
                </div>
                <hr>
                <div class="table-responsive crud-table">
                    <% if(!message) { %>
                    <table class="table table-striped">
                        <tr class="sticky-header">
                            <th>#</th>
                            <th>First Name</th> 
                            <th>Last Name</th> 
                            <th>Email</th> 
                            <th>Phone</th>
                            <th>Action</th> 
                        </tr>
                        <% var i = pagingCounter; %>
                        <% contacts.forEach(contact => { %>
                        <tr>
                            <td><%= i++ %></td>
                            <td><%= contact.first_name %></td>
                            <td><%= contact.last_name %></td>
                            <td><%= contact.email %></td>
                            <td><%= contact.phone %></td>
                            <td class="action-column">
                                <a href="/show-contact/<%= contact._id %>" class="btn btn-warning btn-sm" title="View"><i class="fa fa-eye"></i></a>
                                <a href="/update-contact/<%= contact._id %>" class="btn btn-success btn-sm" title="Edit"><i class="fa fa-pencil"></i></a>
                                <a href="/delete-contact/<%= contact._id %>" class="btn btn-trash btn-sm" title="Delete" onclick="return confirm('Are you sure you want to remove this record?');"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                        <% }); %>
                    </table>
                    <nav>
                        <ul class="pagination justify-content-end">
                            <% let disablePreviousPage = hasPrevPage ? '' : 'disabled'; %>
                            <li class="page-item <%= disablePreviousPage  %>">
                                <a class="page-link" href="/?page=<%= prevPage  %>" tabindex="-1">Previous</a>
                            </li>

                            <% for (let i = 1; i <= totalPages; i++) { 
                                let activeClass = (page == i) ? 'active' : ''; %>
                                <li class="page-item <%= activeClass %>"><a class="page-link" href="/?page=<%= i %>"><%= i %></a></li>
                            <% } %>

                            <% let disableNextPage = hasNextPage ? '' : 'disabled'; %>
                            <li class="page-item <%= disableNextPage  %>">
                                <a class="page-link" href="/?page=<%= nextPage  %>">Next</a>
                            </li>
                        </ul>
                    </nav>
                    <% } else { %>
                    <%= message  %>
                    <% }  %>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer.ejs') %>

</body>
</html>